# Plantilla sin secretos. Node NO carga este archivo automáticamente.
# Configurar estas variables en el proceso del servicio/alojamiento aprobado.
NODE_ENV=production
CAI_PUBLIC_ORIGIN=https://cai.example.test
CAI_TRUST_PROXY=loopback
CAI_API_PORT=3100
CAI_DATA_DIR=/RUTA/PRIVADA/FUERA/DEL/CODIGO

# Google es opcional; usar después el proyecto bajo control de CAI.
GOOGLE_CLIENT_ID=

# Solo para production:setup; sin valores predeterminados ni contraseña en variables.
CAI_BOOTSTRAP_EMAIL=
CAI_BOOTSTRAP_PASSWORD_FILE=

# Opcional: archivo JSON SMTP privado dentro de CAI_DATA_DIR; nunca en el frontend.
# Sin esta variable no se envían correos. Ver docs/GOOGLE_EMAIL.md.
CAI_MAIL_CONFIG=
