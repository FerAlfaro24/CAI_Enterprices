# Configuración del servicio. Copiar al servidor aprobado, fuera del código.
# No basta con colocar este archivo en el repositorio: systemd carga /etc/cai/cai.env.
NODE_ENV=production
CAI_PUBLIC_ORIGIN=https://cai.example.test
CAI_TRUST_PROXY=loopback
CAI_API_PORT=3100
CAI_DATA_DIR=/var/lib/cai
GOOGLE_CLIENT_ID=
CAI_MAIL_CONFIG=/var/lib/cai/mail.json
# El archivo mail.json se crea por canal privado después de renovar la credencial.
# Bootstrap es una operación separada; no dejar su contraseña en el servicio.
